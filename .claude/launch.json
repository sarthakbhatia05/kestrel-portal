{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kestrel-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "kestrel.main:app", "--reload"],
      "port": 8000
